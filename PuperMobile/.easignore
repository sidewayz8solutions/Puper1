# Deployment scripts (not needed for build)
*.sh
deploy-app-store.sh
deploy-cloud-build.sh
deploy-ios.sh
submit-build.sh
BUILD_NOW.sh
SUBMIT_TO_APP_STORE.sh

# EAS example files
eas.json.example

# Ad-related config files (if not needed in bundle)
app-ads.txt

# Package manager artifacts
package-lock.json

# Environment & secrets (handled via EAS secrets, not source)
.env
.env.*
!.env.example

# Scripts you do NOT want in the tarball (keep deploy/build scripts if needed)
# Adjust as needed; keeping build scripts for now
# scripts/local-only/

# Generated assets
npm-packages-offline-cache/

auth/

# Keep important asset directories explicitly
!assets/**
!**/assets/**
!splash.mp4
!**/splash.mp4

# Keep migrations
!migrations/**

# Exclude Supabase Edge Functions (TypeScript, deployed separately)
supabase/functions/**

# Keep only the Supabase client file, not functions
!supabase/supabase.js

# Exclude unused native module directories
ios-native-modules/**
modules/**
plugins/**

# Keep Supabase service files
!services/**

# Keep in-app-purchases metadata
!in-app-purchases/**

# Allow EAS config files
!eas.json
!app.json

# End of file
